token_id})\")\n","print(f\"3. bos_token: {tokenizer.bos_token} (id: {tokenizer.bos_token_id if tokenizer.bos_token_id else 'N/A'})\")\n","\n","# Verificar nuestros tokens personalizados\n","print(\"\\nNuestros tokens personalizados:\")\n","for token in ['<|system|>', '<|user|>', '<|assistant|>', '<|end|>']:\n","    if token in tokenizer.get_vocab():\n","        token_id = tokenizer.convert_tokens_to_ids(token)\n","        print(f\"• {token}: id {token_id}\")\n","    else:\n","        print(f\"• {token}: ❌ NO EXISTE en el vocabulario\")\n","\n","# Problema común: <|end|> vs <|endoftext|>\n","print(\"\\n⚠️  Posible conflicto:\")\n","print(\"• Si <|end|> no existe, el modelo usa <|endoftext|>\")\n","print(\"• En generación, busca <|end|> pero no lo encuentra\")\n","print(\"• Solución: Asegurar que <|end|> está en el tokenizer\")\n","\n","# Solución rápida si <|end|> no existe\n","if '<|end|>' not in tokenizer.get_vocab():\n","    print(\"\\n🔧 Solución: Reemplazar <|end|> por <|endoftext|> en todo el código\")\n","    print(\"   - En dataset: usar <|endoftext|> en lugar de <|end|>\")\n","    print(\"   - En generación: buscar <|endoftext|> en lugar de <|end|>\")"]},{"cell_type":"code","execution_count":10,"id":"d7ca84ca-074a-43c1-b6bb-64da5b43627c","metadata":{"id":"d7ca84ca-074a-43c1-b6bb-64da5b43627c","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1769500686514,"user_tz":480,"elapsed":8124,"user":{"displayName":"Luis Lameiro","userId":"08385374807140768894"}},"outputId":"20f6b87b-fa4f-4a09-e782-1069ed468fd1"},"outputs":[{"output_type":"stream","name":"stdout","text":["🔧 SINCRONIZANDO TOKENS DE FINALIZACIÓN\n","======================================================================\n","✅ Modelo cargado\n","\n","1. 🔄 Configurando tokenizer para usar <|end|> como eos_token...\n","   • eos_token actual: '<|endoftext|>' (id: 50256)\n","   • <|end|> id: 50260\n","   ✅ Nuevo eos_token: '<|end|>' (id: 50260)\n","\n","2. 🎯 Creando función de generación sincronizada...\n","\n","3. 🧪 Probando generación sincronizada...\n","\n","1. ❓ '¿Qué es SEO?'\n","\n","🔍 DEBUG - Generación completa:\n","'<|system|>Eres MaxGPT, experto en marketing digital.<|end|><|user|>¿Qué es SEO?<|end|><|assistant|><|endoftext|>\n","\n","The latest development of this project for the online community is that we have become a global company which will provide access to internet and media information'\n","------------------------------------------------------------\n","   ❌ Sin respuesta válida\n","\n","2. ❓ 'Hola'\n","\n","🔍 DEBUG - Generación completa:\n","'<|system|>Eres MaxGPT, experto en marketing digital.<|end|><|user|>Hola<|end|><|assistant|><|endoftext|>\n","\n","\"We have no other choice but to give a living.\"<|endoftext|>For the first time'\n","------------------------------------------------------------\n","   ❌ Sin respuesta válida\n","\n","3. ❓ 'Marketing digital'\n","\n","🔍 DEBUG - Generación completa:\n","'<|system|>Eres MaxGPT, experto en marketing digital.<|end|><|user|>Marketing digital<|end|><|assistant|><|endoftext|>\n","The first thing to understand is how the European Union's membership of a single union should be structured in an equitable manner'\n","------------------------------------------------------------\n","   ❌ Sin respuesta válida\n","\n","4. ❓ '¿Cómo gano dinero online?'\n","\n","🔍 DEBUG - Generación completa:\n","'<|system|>Eres MaxGPT, experto en marketing digital.<|end|><|user|>¿Cómo gano dinero online?<|end|><|assistant|><|endoftext|>I think that we‍e do have a great time in the year of 2018 with our 2017 launch . If you were looking to use your mobile device for e-commerce and financial services ,'\n","------------------------------------------------------------\n","   ❌ Sin respuesta válida\n","\n"]}],"source":["\n","print(\"🔧 SINCRONIZANDO TOKENS DE FINALIZACIÓN\")\n","print(\"=\" * 70)\n","\n","from transformers import AutoTokenizer, AutoModelForCausalLM\n","import torch\n","\n","# Cargar modelo\n","model_path = \"./maxgpt_cpu_model\"\n","tokenizer = AutoTokenizer.from_pretrained(model_path)\n","model = AutoModelForCausalLM.from_pretrained(model_path)\n","\n","print(\"✅ Modelo cargado\")\n","\n","# SOLUCIÓN 1: Configurar tokenizer para usar <|end|> como eos_token\n","print(\"\\n1. 🔄 Configurando tokenizer para usar <|end|> como eos_token...\")\n","\n","# Verificar tokens actuales\n","print(f\"   • eos_token actual: '{tokenizer.eos_token}' (id: {tokenizer.eos_token_id})\")\n","print(f\"   • <|end|> id: {tokenizer.convert_tokens_to_ids('<|end|>')}\")\n","\n","# Configurar <|end|> como eos_token para generación\n","tokenizer.eos_token = \"<|end|>\"\n","tokenizer.eos_token_id = tokenizer.convert_tokens_to_ids(\"<|end|>\")\n","\n","print(f\"   ✅ Nuevo eos_token: '{tokenizer.eos_token}' (id: {tokenizer.eos_token_id})\")\n","\n","# SOLUCIÓN 2: Función de generación SINCRONIZADA\n","print(\"\\n2. 🎯 Creando función de generación sincronizada...\")\n","\n","def generar_respuesta_sincronizada(pregunta, max_longitud=50):\n","    \"\"\"\n","    Función sincronizada: usa <|end|> como marcador de fin\n","    \"\"\"\n","    # Prompt IDÉNTICO al entrenamiento\n","    prompt = f\"<|system|>Eres MaxGPT, experto en marketing digital.<|end|><|user|>{pregunta}<|end|><|assistant|>\"\n","\n","    inputs = tokenizer(prompt, return_tensors=\"pt\")\n","\n","    with torch.no_grad():\n","        outputs = model.generate(\n","            **inputs,\n","            max_new_tokens=max_longitud,\n","            temperature=0.8,\n","            top_p=0.9,\n","            do_sample=True,\n","            pad_token_id=tokenizer.pad_token_id,  # 50256 (<|endoftext|>)\n","            eos_token_id=tokenizer.eos_token_id,  # ¡NUEVO! 50260 (<|end|>)\n","            repetition_penalty=1.1,\n","            no_repeat_ngram_size=2,\n","        )\n","\n","    # Decodificar\n","    texto_completo = tokenizer.decode(outputs[0], skip_special_tokens=False)\n","\n","    print(f\"\\n🔍 DEBUG - Generación completa:\")\n","    print(f\"'{texto_completo}'\")\n","    print(\"-\" * 60)\n","\n","    # Extraer respuesta (desde <|assistant|> hasta <|end|>)\n","    inicio = texto_completo.find(\"<|assistant|>\") + len(\"<|assistant|>\")\n","    fin = texto_completo.find(\"<|end|>\", inicio)\n","\n","    if fin != -1:\n","        respuesta = texto_completo[inicio:fin].strip()\n","    else:\n","        # Fallback: buscar <|endoftext|>\n","        fin = texto_completo.find(\"<|endoftext|>\", inicio)\n","        if fin != -1:\n","            respuesta = texto_completo[inicio:fin].strip()\n","        else:\n","            respuesta = texto_completo[inicio:].strip()\n","\n","    return respuesta\n","\n","# SOLUCIÓN 3: Probar con diferentes configuraciones\n","print(\"\\n3. 🧪 Probando generación sincronizada...\\n\")\n","\n","preguntas_test = [\n","    (\"¿Qué es SEO?\", 30),\n","    (\"Hola\", 20),\n","    (\"Marketing digital\", 25),\n","    (\"¿Cómo gano dinero online?\", 40)\n","]\n","\n","for i, (pregunta, longitud) in enumerate(preguntas_test, 1):\n","    print(f\"{i}. ❓ '{pregunta}'\")\n","    respuesta = generar_respuesta_sincronizada(pregunta, max_longitud=longitud)\n","\n","    if respuesta and len(respuesta) > 2:\n","        print(f\"   ✅ RESPUESTA: '{respuesta}'\")\n","    else:\n","        print(f\"   ❌ Sin respuesta válida\")\n","\n","    print()"]},{"cell_type":"code","execution_count":11,"id":"73238b73-cc83-493c-89de-a18b486b181c","metadata":{"id":"73238b73-cc83-493c-89de-a18b486b181c","colab":{"base_uri":"https://localhost:8080/","height":487},"executionInfo":{"status":"error","timestamp":1769500692394,"user_tz":480,"elapsed":5874,"user":{"displayName":"Luis Lameiro","userId":"08385374807140768894"}},"outputId":"dd42dd57-6214-43cb-bb97-3c4b81b42a8e"},"outputs":[{"output_type":"error","ename":"HFValidationError","evalue":"Repo id must use alphanumeric chars, '-', '_' or '.'. The name cannot start or end with '-' or '.' and the maximum length is 96: './maxgpt_