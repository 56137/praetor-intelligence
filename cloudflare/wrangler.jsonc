{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "praetor-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ORIGIN_URL": "https://praetor-intelligence.onrender.com"
  }
}
